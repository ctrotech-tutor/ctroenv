# Deliberately BROKEN example environment for with-cli. Copy to .env:
#   cp .env.example .env
# then run `npm run validate` to see grouped missing/invalid errors with
# suggestions. Fix the values below and re-run to see success.
NODE_ENV=development
# Invalid: not a URL (should be e.g. postgresql://app:example-password@localhost:5432/app_db)
DATABASE_URL=not-a-database-url
# Typo: unused key close to DATABASE_URL (watch `check --warn-unknown` suggest it)
DATABSE_URL=postgresql://app:example-password@localhost:5432/app_db
# Invalid: shorter than the 32-character minimum
JWT_SECRET=short
CORS_ORIGIN=http://localhost:3000
PORT=3000
# API_VERSION is intentionally missing (required, e.g. 1.0)
