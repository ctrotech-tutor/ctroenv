# Example environment for with-express. Copy to .env and adjust:
#   cp .env.example .env
DATABASE_URL=postgresql://app:example-password@localhost:5432/app_db
JWT_SECRET=local-dev-jwt-secret-not-for-production-use
CORS_ORIGIN=http://localhost:3000
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
# Optional: uncomment to set it.
# REDIS_URL=redis://localhost:6379
