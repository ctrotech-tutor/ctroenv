# Shared example environment for the monorepo example (used by both the API
# and the worker via loadEnv({ path: "../.." })). Copy to .env and adjust:
#   cp .env.example .env
NODE_ENV=development
DATABASE_URL=postgresql://app:example-password@localhost:5432/app_db
JWT_SECRET=local-dev-jwt-secret-not-for-production-use
CORS_ORIGIN=http://localhost:3000
API_VERSION=1.0
# Optional: uncomment to set it.
# REDIS_URL=redis://localhost:6379
