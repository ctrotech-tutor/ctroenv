# Example environment for with-nextjs. Copy to .env and adjust:
#   cp .env.example .env
DATABASE_URL=postgresql://app:example-password@localhost:5432/app_db
JWT_SECRET=local-dev-jwt-secret-not-for-production-use
REDIS_URL=redis://localhost:6379
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_APP_NAME=CtroEnv Demo
# Optional: uncomment to set it.
# NEXT_PUBLIC_SENTRY_DSN=https://example@sentry.io/1
