# Example environment for basic-node. Copy to .env and adjust:
#   cp .env.example .env
# Values below are fake local-dev placeholders (safe to commit here, but
# never commit a real .env).
DATABASE_URL=postgresql://app:example-password@localhost:5432/app_db
JWT_SECRET=local-dev-jwt-secret-not-for-production-use
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
FEATURE_X_ENABLED=false
API_VERSION=1.0
# Optional: uncomment to set it.
# CORS_ORIGIN=http://localhost:3000
